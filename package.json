{
  "name": "todolab-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "node scripts/lint.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/unit tests/acceptance",
    "test:unit": "node --test tests/unit",
    "test:acceptance": "node --test tests/acceptance",
    "test:coverage": "node --test --experimental-test-coverage tests/unit tests/acceptance",
    "test:coverage:gate": "node scripts/check-coverage.mjs",
    "guard:tests": "node scripts/guard-tests.mjs",
    "check": "npm run lint && npm run build"
  }
}
